# Modelo do .env da raiz (o .env real nunca vai para o git). Lido pelo docker compose.

# Segredo do JWT da API (gere com: openssl rand -base64 64)
JWT_SECRET=
# Token compartilhado entre a API Java e o motor Python (cabeçalho X-Parser-Token)
PARSER_TOKEN=
# Chave do OpenRouter usada pelo motor Python
OPENROUTER_API_KEY=

# Cloudflare Tunnel: token do túnel criado no painel Zero Trust (Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
# Liga o serviço "tunnel" do compose.yaml; deixe vazio até ter o token
COMPOSE_PROFILES=

# Portas locais (só 127.0.0.1) para testar sem o túnel
BACKEND_HOST_PORT=18080
PARSER_HOST_PORT=18000
