# Desenvolvimento local: o navegador chama a API direto.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Vercel (Settings → Environment Variables), em vez da linha acima:
#   NEXT_PUBLIC_API_URL=/                               o navegador fala só com o próprio site
#   API_PROXY_TARGET=https://api.seudominio.com         o site repassa /api/* para o backend
